{
  "id": "transitions/cross-dissolve",
  "description": "Two copies of the 25 fps clip cut together at frame 80, each with 20 frames of handle (A's out at 80; B's in at 20, which moves its start to 100, then moved back to start at 80), and a cross dissolve on A's end, centred on the cut by default. Varied over the duration.",
  "media": ["v25_h264_aac.mp4"],
  "sequences": [{ "name": "Main", "fromMedia": "v25_h264_aac.mp4" }],
  "ops": [
    { "op": "trim", "clip": { "kind": "video", "track": 0, "index": 0 }, "out": { "frames": 80 } },
    { "op": "overwrite", "media": "v25_h264_aac.mp4", "at": { "frames": 80 }, "video": 0, "audio": 0 },
    { "op": "trim", "clip": { "kind": "video", "track": 0, "index": 1 }, "in": { "frames": 20 } },
    { "op": "move", "clip": { "kind": "video", "track": 0, "index": 1 }, "to": { "frames": 80 } },
    { "op": "transition", "clip": { "kind": "video", "track": 0, "index": 0 }, "end": "end",
      "match": "cross ?dissolve", "duration": { "frames": 20 } }
  ],
  "vary": { "param": "ops.4.duration.frames", "values": [10, 20] }
}
